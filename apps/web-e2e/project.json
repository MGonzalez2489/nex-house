{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["web"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web-e2e",
        "command": "npm run e2e:db:reset && npx playwright test"
      },
      "dependsOn": [
        "api:build",
        { "projects": ["web"], "target": "build", "configuration": "development" }
      ]
    },
    "e2e-ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web-e2e",
        "command": "npm run e2e:db:reset && npx playwright test"
      },
      "dependsOn": [
        "api:build",
        { "projects": ["web"], "target": "build", "configuration": "development" }
      ]
    }
  }
}