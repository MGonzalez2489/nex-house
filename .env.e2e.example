# E2E environment template. Copy to `.env.e2e` (gitignored) and adjust if needed.
# The e2e stack runs the API on :3001 against the isolated `nexhouse_e2e`
# database (same docker `db` container, port 3307). The DB is dropped and
# recreated at the start of every e2e run, so values here just need to be valid.

# Database Configuration (shared container, isolated schema)
DB_HOST=localhost
DB_PORT=3307
DB_USER='pAdmin'
DB_PASSWORD='1234'
DB_ROOT_PASSWORD='1234'
DB_NAME=nexhouse_e2e

# API Configuration
API_URL='http://localhost'
API_PORT=3000

# CLIENT Configuration
CLIENT_URL='http://localhost:4288'

# Security
JWT_SECRET='e2eSecretKeyDoNotUseInProd'
JWT_EXPIRRE='86400000' #ms
JWT_RESET='e2eResetTokenSecret'

# defaults
SUPER_ADMIN_USER='root@test.com'
SUPER_ADMIN_PWD='1234'

# Uploads
UPLOAD_DIR='uploads'

#others
USE_REDIS=false